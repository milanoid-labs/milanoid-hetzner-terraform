# direnv config: run `direnv allow` once after cloning, and again after editing this file.
#
# Holds no secrets, so it's safe to commit. The Hetzner Cloud API token (project
# milanoid-backup, Read & Write) lives outside git in ~/.config/milanoid-hetzner-terraform.env
# (mode 600), a dotenv file with:
#   HCLOUD_TOKEN=...        # read by the hetznercloud/hcloud provider
#   AWS_PROFILE=milanoid    # S3 state backend
# CI gets the token from the repo secret HCLOUD_TOKEN instead.

# Run Claude Code on the personal account in this repo (the work account keeps the
# default ~/.claude). Only applies when `claude` is started from a direnv-loaded shell.
export CLAUDE_CONFIG_DIR="$HOME/.claude-personal"

secrets_file="$HOME/.config/milanoid-hetzner-terraform.env"

if [[ -f "$secrets_file" ]]; then
  # dotenv exports plain KEY=value lines and watches the file, so direnv reloads when it changes.
  dotenv "$secrets_file"
else
  log_error "missing $secrets_file (see .envrc); the hcloud provider will have no token"
fi

# Fall back to the shared profile if the secrets file doesn't set one.
export AWS_PROFILE="${AWS_PROFILE:-milanoid}"

if [[ -z "${HCLOUD_TOKEN:-}" ]]; then
  log_error "HCLOUD_TOKEN is not set"
fi
